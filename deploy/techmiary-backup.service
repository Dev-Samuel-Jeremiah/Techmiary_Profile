# /etc/systemd/system/techmiary-backup.service
#
# One-shot backup, driven by techmiary-backup.timer.
#
[Unit]
Description=Back up the Techmiary SQLite database
After=techmiary-portfolio.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/portfolio
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/srv/portfolio/.env
ExecStart=/srv/portfolio/deploy/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/portfolio/data
UMask=0027

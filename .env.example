# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-50-character-random-string

DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Canonical origin — used for canonical links, Open Graph tags and the sitemap.
SITE_URL=https://example.com

# Move the admin off the default path.
ADMIN_URL=admin/

# --- Database --------------------------------------------------------------
# Either a single URL...
DATABASE_URL=postgres://portfolio:change-me@127.0.0.1:5432/portfolio
# ...or the discrete settings:
# DB_NAME=portfolio
# DB_USER=portfolio
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
CONN_MAX_AGE=60

# --- Email -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Techmiary <no-reply@example.com>
# Where contact-form notifications are delivered.
CONTACT_NOTIFICATION_EMAIL=you@example.com

# --- Behaviour -------------------------------------------------------------
TIME_ZONE=Africa/Lagos
# Reverse proxies in front of the app. The shipped nginx config is one hop,
# so set this to 1 when deploying behind it. Leaving it at 0 makes every
# visitor share nginx's address and therefore one contact-form rate limit.
TRUSTED_PROXY_COUNT=1

CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
BLOG_PAGE_SIZE=6
PROJECT_PAGE_SIZE=9
SITE_CONTEXT_CACHE_SECONDS=300
LOG_LEVEL=INFO

# --- Production hardening --------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Comma-separated "Name|email" pairs that receive 500-error reports.
DJANGO_ADMINS=Samuel Jeremiah|you@example.com
